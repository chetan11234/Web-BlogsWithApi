<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles/main.css">
    <title>User Blogs</title>
</head>
<body>
    <section>
        <div id="postBlock">
            <form action="/blogForm" method="post">
                <button type="submit" >Publish</button>
            </form>
        </div>
        <% 
        if(locals.userBlogs){
            userBlogs.forEach((element) => {
                %>
                <div>
                    <span><%= element.title %></span>
                    <div>
                        <%= element.description %>
                    </div>
                    <div>
                    <form id ="editForm" method="post">
                        <input type="hidden" name="_method" value="PATCH">
                       <button type="submit" value="Edit" formaction="<%=`/edit/${element.id}`%>">Edit</button> 
                        
                    </form>
                    <form id="deleteForm" method="post">
                        <input type="hidden" name="_method" value="DELETE">
                        <button type="submit" value="Delete" formaction= "<%=`/delete/${element.id}`%>">Delete</button>
                    </form>
                    </div>
                </div>
                <%
            });
        }
        %>
    </section>
</body>
</html>