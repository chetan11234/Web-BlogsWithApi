<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Update Blog</title>
</head>
<body>
    <section>
        <h1>Write your Blog</h1>
    <form method="post"> 
        <label for="title">
            Title:
        </label>
        <input type="text" name="title" value="<%=userBlogs.title%>">
        <label for="description">
            Description:
        </label>
        <input type="text" name ="description" value="<%=userBlogs.description%>">
        
        
        <input type="hidden" name="_method" value="PATCH">
        <button type="submit" value="submit" formaction= <%=`/patch/${userBlogs.id}`%>>Submit</button>
    </form>
    <%if(userBlogs.editedAt != ""){
        %>
        <span>Last updated on : <%=userBlogs.editedAt %></span>
    <%}%>
    <span>Published on : <%=userBlogs.postedAt %></span>
    </section>
</body>
</html>